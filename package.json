{
  "name": "nox-bot",
  "version": "1.0.0",
  "description": "NoX Bot \u2014 multi-guild Discord bot with built-in plugins and a realtime dashboard",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "workspaces": [
    "web"
  ],
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start": "node --loader ts-node/esm src/index.ts",
    "dev": "node --loader ts-node/esm --watch src/index.ts",
    "build": "node scripts/clean-build.mjs && tsc && node scripts/copy-runtime-files.mjs && node scripts/verify-catalog.mjs",
    "copy:assets": "node scripts/copy-runtime-files.mjs && node scripts/verify-catalog.mjs",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces",
    "build:web": "npm run build --workspace web",
    "test:state": "npm run build && node --test tests/sqlite.integration.test.mjs tests/availability.integration.test.mjs",
    "test": "npm run build && npm run build:web && node --test tests/*.test.mjs",
    "release": "node scripts/release.mjs",
    "test:ci-policy": "node --test scripts/ci-policy.test.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "prepare": "node --input-type=module -e \"import { existsSync } from 'node:fs'; if (existsSync('scripts/install-hooks.mjs')) await import('./scripts/install-hooks.mjs');\"",
    "precommit": "node scripts/git-hooks.mjs commit",
    "check": "node scripts/git-hooks.mjs check",
    "prepush": "npm run check",
    "test:release": "node --test scripts/release.test.mjs scripts/ci-policy.test.mjs",
    "check:code": "vp check",
    "format:check": "vp fmt --check",
    "format": "vp fmt"
  },
  "dependencies": {
    "@discordjs/opus": "0.10.0",
    "@discordjs/voice": "0.19.2",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.3.1",
    "@nox/mcp": "https://github.com/mapherez/nox-mcp/releases/download/v0.6.1/nox-mcp.tgz",
    "cheerio": "^1.0.0-rc.12",
    "discord.js": "^14.22.1",
    "dotenv": "^17.2.3",
    "nodehun": "^3.0.2",
    "ws": "8.22.0",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^24.6.2",
    "@types/ws": "8.18.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite-plus": "1.6.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0"
  },
  "overrides": {
    "@discordjs/node-pre-gyp": {
      "tar": "7.5.22"
    },
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0"
  },
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "allowScripts": {
    "nodehun@3.0.2": true,
    "@discordjs/opus@0.10.0": true
  }
}
