# Required
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_application_client_id_here

# Optional: set this for instant slash-command registration in one server.
GUILD_ID=your_discord_server_id_here

# Optional: only needed for /nox weather
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Optional control API (disabled by default; separate from DISCORD_TOKEN).
# API host must be an IP address or localhost. The Docker API override sets 0.0.0.0 internally.
NOX_DISCORD_API_ENABLED=false
NOX_DISCORD_API_HOST=127.0.0.1
NOX_DISCORD_API_PORT=3100
NOX_DISCORD_API_KEY=

# Optional runtime version override. Otherwise use incorporated build metadata, then dev.
NOX_DISCORD_VERSION=
