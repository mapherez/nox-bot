DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
NOX_BOT_OWNER_DISCORD_USER_ID=
NOX_BOT_PUBLIC_URL=https://bot.example.com
NOX_BOT_ENCRYPTION_KEY=
NOX_BOT_SESSION_SECRET=

# Compose sets private DB URL and service credentials automatically.
# For local development after controlled provisioning:
# NOX_BOT_SPACETIMEDB_URL=http://127.0.0.1:3300
# NOX_BOT_SPACETIMEDB_DATABASE=nox-bot
# NOX_BOT_STATE_CREDENTIAL_FILE=/private/path/service-credentials.json
NOX_BOT_DASHBOARD_HOST=127.0.0.1
NOX_BOT_DASHBOARD_PORT=3200

# Optional independent bearer API; disabled by default.
NOX_BOT_API_ENABLED=false
NOX_BOT_API_HOST=127.0.0.1
NOX_BOT_API_PORT=3100
NOX_BOT_API_KEY=
