DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
NOX_BOT_OWNER_DISCORD_USER_ID=
NOX_BOT_PUBLIC_URL=https://bot.example.com
NOX_BOT_ENCRYPTION_KEY=
NOX_BOT_SESSION_SECRET=

# SQLite file, relative to the process working directory.
# Docker uses /app as its working directory and persists /app/data in the bot-data volume.
NOX_BOT_DATABASE_PATH=./data/nox-bot.sqlite

NOX_BOT_DASHBOARD_HOST=127.0.0.1
NOX_BOT_DASHBOARD_PORT=3200
# Compose host interface. Set the host's private LAN IP for direct LAN access.
NOX_BOT_DASHBOARD_BIND_ADDRESS=127.0.0.1
# Example: NOX_BOT_DASHBOARD_BIND_ADDRESS=192.168.1.50
# Also set NOX_BOT_PUBLIC_URL=http://192.168.1.50:3200 and register its
# /auth/callback URL in Discord Developer Portal.

# Optional independent bearer API; disabled by default.
NOX_BOT_API_ENABLED=false
NOX_BOT_API_HOST=127.0.0.1
NOX_BOT_API_PORT=3100
NOX_BOT_API_KEY=

# Optional NoX Voice (see docs/VOICE.md). No value means voice is unavailable; other features work normally.
# HTTPS controller address of nox-voice-mlx, reachable from this container.
NOX_VOICE_CONTROLLER_URL=
# Paths INSIDE the container; the optional Compose override mounts the existing client bundle here.
NOX_VOICE_CA_FILE=/run/nox-voice/ca.crt
NOX_VOICE_CLIENT_CERT_FILE=/run/nox-voice/client.crt
NOX_VOICE_CLIENT_KEY_FILE=/run/nox-voice/client.key
# HOST directory holding ONLY the CA cert, client cert and client key. Used by the override.
NOX_VOICE_SECRETS_DIR=./secrets
